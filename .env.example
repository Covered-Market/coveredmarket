# Copy to .env. For `bin/coveredmarket up` the local bootstrap appends everything it needs below a marker line;
# The light client on NEAR testnet follows Bitcoin testnet3, so the testnet stack uses testnet3 Esplora.
# for the cloud, fill this in and pass it as `env_file` in infra/cloud/terraform.tfvars.
MODE=testnet
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com
COVERED_ID=coveredmarket.testnet
USDC_ID=usdc.fakes.testnet
SIGNER_ID=v1.signer-prod.testnet
LIGHT_CLIENT_ID=btc-client-v4.testnet
RELAYER_ID=
RELAYER_KEY=
BTC_BACKEND=esplora
ESPLORA=https://mempool.space/testnet/api,https://blockstream.info/testnet/api
EXPLORER_BTC=https://mempool.space/testnet
EXPLORER_NEAR=https://testnet.nearblocks.io
MIN_CONF=1
CODE_HASH=

# Optional. The mainnet waitlist on the website (POST /api/waitlist). Every signup is stored in WAITLIST_FILE on the
# relayer_data volume. With an IMAP login each one is also put in that inbox as a message (IMAP, not SMTP, because
# DigitalOcean blocks outbound SMTP). CI deploys write these from the secret WAITLIST_IMAP_PASS and the variables
# WAITLIST_IMAP_HOST, WAITLIST_IMAP_USER and WAITLIST_TO.
# WAITLIST_FILE=/data/waitlist.jsonl
# WAITLIST_TO=waitlist@example.com      # default: IMAP_USER
# WAITLIST_PER_IP_PER_HOUR=5
# WAITLIST_PER_DAY=500
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=waitlist@example.com
# IMAP_PASS=
# IMAP_MAILBOX=INBOX
