RELAYER_ID=
RELAYER_KEY=
BTC_BACKEND=esplora
ESPLORA=https://mempool.space/testnet4/api
EXPLORER_BTC=https://mempool.space/testnet4
EXPLORER_NEAR=https://testnet.nearblocks.io
MIN_CONF=1
CODE_HASH=
