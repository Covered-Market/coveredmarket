#!/usr/bin/env bash
# The one entry point. `bin/coveredmarket help`.
set -euo pipefail
COVEREDMARKET_CALLER_PWD="$PWD"; ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"; cd "$ROOT"
LOCAL=(--env-file .env -f infra/compose.yaml -f infra/compose.local.yaml)
need() { command -v "$1" >/dev/null || { echo "missing: $1 ($2)"; exit 1; }; }
cmd=${1:-help}; shift || true
case "$cmd" in
  up)        # full local stack: sandbox + regtest + contracts + relayer + web
    need docker "https://docs.docker.com/get-docker/"; touch .env
    # phase 1: chain, bitcoin, wasm, bootstrap (writes ids and keys into .env); phase 2: relayer + web read that .env
    docker compose "${LOCAL[@]}" up -d --build bootstrap "$@"
    docker compose "${LOCAL[@]}" wait bootstrap >/dev/null || true
    code=$(docker inspect -f '{{.State.ExitCode}}' "$(docker compose "${LOCAL[@]}" ps -aq bootstrap)")
    if [ "$code" != "0" ]; then docker compose "${LOCAL[@]}" logs bootstrap contracts near-sandbox bitcoind | tail -80; echo "bootstrap failed ($code)"; exit 1; fi
    docker compose "${LOCAL[@]}" up -d --build relayer web config
    for i in $(seq 1 60); do curl -fsS localhost/api/health >/dev/null 2>&1 && curl -fsS localhost/config.json >/dev/null 2>&1 && break; sleep 2
      [ "$i" = 60 ] && { docker compose "${LOCAL[@]}" logs relayer web config | tail -80; echo "stack did not come up"; exit 1; }; done
    echo; echo "CoveredMarket is at http://localhost  (NEAR sandbox :3030, bitcoind :18443). Demo users and keys: bin/coveredmarket keys" ;;
  down)      docker compose "${LOCAL[@]}" down "$@" ;;
  reset)     docker compose "${LOCAL[@]}" down -v; rm -f .env; echo "state wiped; run: bin/coveredmarket up" ;;
  e2e-stack) # full product run against the local stack: API flows (KEPT, EXERCISED) + UI + Verify; screenshots in e2e/artifacts
    (cd e2e && npm ci --silent && npx playwright install chromium >/dev/null && node run.mjs) ;;
  logs)      docker compose "${LOCAL[@]}" logs -f --tail=100 "$@" ;;
  ps)        docker compose "${LOCAL[@]}" ps ;;
  keys)      docker compose "${LOCAL[@]}" run --rm --no-deps -v coveredmarket_config:/config alpine cat /config/demo-keys.txt ;;
  btc)       # regtest helpers: btc send <address> <btc> | btc mine [n] | btc cli <args…>
    sub=${1:-}; shift || true
    case "$sub" in
      send) curl -sS -X POST localhost/btc/dev/send -H 'content-type: application/json' -d "{\"address\":\"$1\",\"btc\":$2}"; echo; curl -sS -X POST localhost/btc/dev/mine -H 'content-type: application/json' -d '{"n":1}'; echo ;;
      mine) curl -sS -X POST localhost/btc/dev/mine -H 'content-type: application/json' -d "{\"n\":${1:-1}}"; echo ;;
      cli)  docker compose "${LOCAL[@]}" exec bitcoind bitcoin-cli -regtest -rpcuser=coveredmarket -rpcpassword=coveredmarket "$@" ;;
      *) echo "btc send <addr> <btc> | btc mine [n] | btc cli <args>"; exit 1 ;;
    esac ;;
  test)      cargo test -p coveredmarket && (cd relayer && npm test) && (cd web && npm test) && (cd agent && npm test) ;;
  build)     set -e; for c in coveredmarket mock-signer mock-btc-client mock-usdc; do cargo near build non-reproducible-wasm --manifest-path contracts/$c/Cargo.toml; done ;;
  e2e)       "$0" build && cargo test -p integration -- --test-threads=1 ;;
  serve)     # on the cloud VM: first start on testnet creates its own contracts, then the two-container stack
    touch .env
    if ! grep -qE '^COVERED_ID=.+' .env; then
      docker compose --env-file .env -f infra/compose.yaml -f infra/compose.testnet.yaml run --rm --build bootstrap-testnet
    fi
    PROFILES=(); grep -qE '^COVERED_ID=.+' .env.mainnet 2>/dev/null && PROFILES=(--profile mainnet)
    docker compose --env-file .env -f infra/compose.yaml "${PROFILES[@]}" up -d --build --remove-orphans && docker image prune -f >/dev/null
    for i in $(seq 1 90); do curl -fsS localhost/api/health >/dev/null 2>&1 && break; sleep 2; done
    curl -fsS localhost/api/health; echo ;;
  agent)     # CoveredMarket for agents and scripts, JSON out (agent/README.md): bin/coveredmarket agent offers --status for_sale
    [ -d agent/node_modules ] || (cd agent && npm ci --silent >&2)
    cd "$COVEREDMARKET_CALLER_PWD" && exec "$ROOT/agent/node_modules/.bin/tsx" "$ROOT/agent/src/cli.ts" "$@" ;;
  mcp)       # the same as an MCP server on stdio: claude mcp add coveredmarket -- <repo>/bin/coveredmarket mcp
    [ -d agent/node_modules ] || (cd agent && npm ci --silent >&2)
    exec "$ROOT/agent/node_modules/.bin/tsx" "$ROOT/agent/src/mcp.ts" ;;
  rescue)    # the seller's exit, with only Bitcoin: bin/coveredmarket rescue <kit.json> <your-btc-address> [--fee-rate N] [--esplora URL] [--broadcast]
    kit=${1:?usage: bin/coveredmarket rescue <kit.json> <your-btc-address> [--broadcast]}; shift
    case "$kit" in /*) ;; *) kit="${COVEREDMARKET_CALLER_PWD:-$PWD}/$kit" ;; esac
    if command -v node >/dev/null && [ -d relayer/node_modules ]; then (cd relayer && npx tsx src/rescue.ts "$kit" "$@")
    else touch .env; docker compose --env-file .env -f infra/compose.yaml run --rm -T --no-deps relayer node dist/rescue.js - "$@" < "$kit"; fi ;;
  provision) # create or update the VM (+ DNS if a domain is set) from infra/cloud/terraform.tfvars or TF_VAR_*, then deploy
    need terraform "https://developer.hashicorp.com/terraform/install"
    (cd infra/cloud && terraform init -input=false >/dev/null && terraform apply -input=false -auto-approve "$@")
    "$0" deploy ;;
  deploy)    # ship the committed tree to the VM and (re)start it: bin/coveredmarket deploy [ip] [site]
    tf() { (cd infra/cloud && terraform output -raw "$1" 2>/dev/null) || true; }
    host=${1:-${DEPLOY_HOST:-$(tf ip)}}; site=${2:-${SITE:-$(tf site)}}
    [ -n "$host" ] || { echo "no host: pass an ip, set DEPLOY_HOST, or provision first"; exit 1; }
    SSH=(ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 ${DEPLOY_KEY:+-i "$DEPLOY_KEY"} "deploy@$host")
    echo "waiting for $host to finish first boot…"
    for i in $(seq 1 60); do "${SSH[@]}" 'test -f /var/lib/covered-ready && docker info >/dev/null 2>&1' 2>/dev/null && break; sleep 10
      [ "$i" = 60 ] && { echo "VM not ready"; exit 1; }; done
    git archive --format=tar HEAD | "${SSH[@]}" 'cd /opt/covered && find . -mindepth 1 -maxdepth 1 ! -name .env -exec rm -rf {} + && tar -x'
    # Waitlist inbox login, when the deployer has it (CI: repository secret WAITLIST_IMAP_PASS): written into the VM's
    # .env over stdin, so the password is never on a command line, and base64-encoded, so no character in it can trip
    # compose's .env parsing ($, #, quotes). Without it the VM keeps whatever .env already has.
    if [ -n "${IMAP_PASS:-}" ]; then
      printf 'IMAP_HOST=%s\nIMAP_USER=%s\nIMAP_PASS_B64=%s\nWAITLIST_TO=%s\n' "${IMAP_HOST:-imap.webhuset.no}" "${IMAP_USER:-contact@covered.market}" "$(printf %s "$IMAP_PASS" | base64 | tr -d '\n')" "${WAITLIST_TO:-contact@covered.market}" \
        | "${SSH[@]}" 'cd /opt/covered && touch .env && grep -vE "^(IMAP_HOST|IMAP_USER|IMAP_PASS|IMAP_PASS_B64|WAITLIST_TO)=" .env > .env.new; cat >> .env.new && chmod 600 .env.new && mv .env.new .env'
    fi
    # The website on $site, the two apps on testnet.$site and mainnet.$site, www.$site redirecting to $site.
    mainnet=${MAINNET_SITE:-${site:+mainnet.$site}}; testnet=${TESTNET_SITE:-${site:+testnet.$site}}; www=${site:+www.$site}
    "${SSH[@]}" "cd /opt/covered && { [ -z '$site' ] || { sed -i '/^DOMAIN=/d; /^MAINNET_DOMAIN=/d; /^TESTNET_DOMAIN=/d; /^WWW_DOMAIN=/d' .env; printf 'DOMAIN=%s\nTESTNET_DOMAIN=%s\nMAINNET_DOMAIN=%s\nWWW_DOMAIN=%s\n' '$site' '$testnet' '$mainnet' '$www' >> .env; }; } && { [ -z '${RESET_CONTRACT:-}' ] || sed -i '/^COVERED_ID=/d' .env; } && bin/coveredmarket serve"
    [ -n "$site" ] && { for i in $(seq 1 60); do curl -fsS "https://$testnet/api/health" >/dev/null 2>&1 && break; sleep 5; done; echo "live: https://$site (app: https://$testnet, https://$mainnet)"; } ;;
  destroy)   (cd infra/cloud && terraform destroy "$@") ;;
  help|*)    cat <<'H'
coveredmarket — one entry point

  local
    up                 start everything locally (sandbox, regtest, contracts, relayer, web) → http://localhost
    down | reset       stop | stop and wipe chain state
    logs [svc] | ps    follow logs | status
    keys               demo users (astrid, marcus) and their keys
    btc send A X       send X BTC to address A on regtest and mine a block
    btc mine [n]       mine n blocks
    btc cli …          bitcoin-cli passthrough
  tests
    test               L0: contract, relayer, web unit tests
    build              wasm for the contracts (needs rustup wasm32 target + cargo-near)
    e2e                L1: sandbox integration tests
    e2e-stack          against a running `up`: both contract lifecycles through relayer, bitcoind and UI, then Verify
  agents (testnet and local only; agent/README.md)
    agent <cmd> …      JSON CLI: params, offers, offer N, me, sell, faucet-deposit, buy, exercise, claim, wait …
    mcp                MCP server on stdio with the same operations
  rescue <kit.json> <address> [--broadcast]   sweep a deposit with the seller's rescue kit after its unlock (no NEAR needed)

  cloud (DigitalOcean, one VM, Caddy TLS on your domain or <ip>.sslip.io)
    provision          terraform apply (infra/cloud/terraform.tfvars), then deploy
    deploy [ip] [site] ship the committed tree over ssh and restart (first start on testnet deploys its own contracts)
    serve              (on the VM) what deploy runs there
    destroy            tear the VM and DNS down
H
    ;;
esac
