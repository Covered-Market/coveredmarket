# One Caddy serves the static app for each network, proxies that network's relayer, and gets TLS per site.
(app) {
	encode gzip
	handle /api/* {
		reverse_proxy {args[0]}
	}
	handle /btc/* {
		reverse_proxy {args[0]}
	}
	handle /config.json {
		root * /config
		rewrite * /{args[1]}
		file_server
		header Cache-Control no-store
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS} {
	import app relayer:8787 primary.json
}

{$MAINNET_ADDRESS} {
	import app relayer-mainnet:8787 mainnet.json
}
